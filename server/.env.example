# Server
PORT=3000

# MongoDB (required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Script seed (npm run seed:*): nếu lỗi querySrv ECONNREFUSED — đã dùng DNS 8.8.8.8 trong code.
# Vẫn lỗi thì thử thêm (Windows / mạng IPv6):
# MONGODB_SEED_FAMILY=4
# MONGODB_SERVER_SELECTION_MS=90000

# Auth / Crypto (required)
JWT_SECRET=replace_with_a_long_random_secret
SECRET_CRYPTO=replace_with_a_long_random_crypto_key

# Gmail OAuth2 (optional - for forgot password / notifications)
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=
REFRESH_TOKEN=
USER_EMAIL=

# (Tuỳ chọn) URL gốc khi chạy `npm run sync:upload-images` — tải file uploads/... từ bản deploy cũ
# UPLOAD_SYNC_BASE_URL=https://your-domain.com
